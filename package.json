{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@x1aoye/tao-tie-oc",
  "version": "0.0.1-alpha.4",
  "type": "module",
  "private": false,
  "description": "饕餮 (TaoTie) — Context pruning plugin for opencode. Reduces token usage by trimming stale tool outputs automatically.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev": "opencode plugin dev"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "context",
    "pruning",
    "token"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoex1aoye/tao-tie-oc.git"
  },
  "bugs": {
    "url": "https://github.com/zoex1aoye/tao-tie-oc/issues"
  },
  "homepage": "https://github.com/zoex1aoye/tao-tie-oc#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "zoex",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
